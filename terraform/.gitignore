# Local .terraform directories
**/.terraform/*

# .terraform/plugins directory may contain sensitive data, excluding it
**/.terraform/plugins/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore override files as they are usually local configurations
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan

# Terraform variable files which can contain sensitive data
*.tfvars
*.tfvars.json

# Sensitive data in provider configuration
.terraformrc
terraform.rc

# Terraform lock file
.terraform.lock.hcl

frontend_build
